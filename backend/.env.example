# Application Environment
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/vayal2veedu_db?schema=public"

# Security & JWT Tokens
JWT_SECRET="vayal2veedu_super_secret_jwt_key_2026_change_in_production"
JWT_REFRESH_SECRET="vayal2veedu_super_secret_refresh_key_2026"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS Configuration
CORS_ORIGIN="*"

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY="your_firebase_fcm_server_key_here"

# Image Storage Configuration (Cloudinary / AWS S3 Abstraction)
STORAGE_PROVIDER="local"
STORAGE_URL="http://localhost:3000/uploads"

# Optional Gemini AI Configuration ("FarmAssist")
GEMINI_API_KEY="your_gemini_api_key_here"
